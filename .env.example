# ==============================================================================
# SMART LOGISTICS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust credentials for your environment
# ==============================================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars-minimum

# MySQL Database Configuration
# Default driver uses PyMySQL (pure Python, zero compilation needed)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_logistics_db
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here

# SQLite Fallback Option
# Set to 'True' if you want to test locally with SQLite before connecting to MySQL
USE_SQLITE_FALLBACK=False
